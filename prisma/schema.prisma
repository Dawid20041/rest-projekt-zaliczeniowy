generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       Int       @id @default(autoincrement())
  username String
  email    String    @unique
  password String?
  auctions Auction[]
}

model Auction {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  category      String
  startingPrice Float
  currentPrice  Float
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE")
  ownerId       Int
  owner         User     @relation(fields: [ownerId], references: [id])
}